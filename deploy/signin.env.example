# oauth2-proxy settings for Microsoft Entra ID (see docs/SERVER.md, "Entra ID app registration").
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_PROVIDER_DISPLAY_NAME=Microsoft Entra ID
OAUTH2_PROXY_OIDC_ISSUER_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
OAUTH2_PROXY_CLIENT_ID=YOUR-APPLICATION-CLIENT-ID
OAUTH2_PROXY_CLIENT_SECRET=YOUR-CLIENT-SECRET
OAUTH2_PROXY_REDIRECT_URL=https://vulnscan.yourcompany.internal/oauth2/callback
OAUTH2_PROXY_SCOPE=openid email profile
OAUTH2_PROXY_OIDC_EMAIL_CLAIM=preferred_username
OAUTH2_PROXY_OIDC_GROUPS_CLAIM=groups
# Only people in this Entra group may open VulnScan at all (group object ID):
OAUTH2_PROXY_ALLOWED_GROUPS=00000000-0000-0000-0000-000000000000
OAUTH2_PROXY_EMAIL_DOMAINS=*
# Random 32-byte secret: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=REPLACE-WITH-RANDOM-SECRET
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_REVERSE_PROXY=false
