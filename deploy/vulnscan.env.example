# Who can start scans and change sources (everyone else who can sign in can view and export).
# Entra ID group object IDs, comma separated (needs the "groups" claim - see docs/SERVER.md):
VULNSCAN_ADMIN_GROUPS=00000000-0000-0000-0000-000000000000
# ...and/or individual sign-in names:
VULNSCAN_ADMINS=
# How often to collect, in hours:
VULNSCAN_SCAN_EVERY_HOURS=6

# Corporate outbound proxy, if the server must use one:
# HTTPS_PROXY=http://proxy.yourcompany.internal:8080
# NO_PROXY=localhost,127.0.0.1,vulnscan
# If that proxy inspects HTTPS, trust the company root certificate as well
# (mount it in docker-compose.yml):
# VULNSCAN_EXTRA_CA_FILE=/certs/company-root.pem
